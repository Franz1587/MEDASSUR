.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Firebase (2026-09) — google-services.json identifie le projet FCM (peu
# sensible seul, mais jamais publié par prudence) ; la clé de compte de
# service (*firebase-adminsdk*.json) donne un accès d'envoi complet à FCM —
# ne JAMAIS la committer.
google-services.json
*firebase-adminsdk*.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
