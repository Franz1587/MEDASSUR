DATABASE_URL="postgresql://postgres:password@localhost:5432/medassur_dev?schema=public"
# En local, DIRECT_URL == DATABASE_URL (pas de pooler). En production
# Supabase : DATABASE_URL = chaîne "Connection pooling" (port 6543,
# ?pgbouncer=true), DIRECT_URL = chaîne "Direct connection" (port 5432,
# utilisée uniquement par `prisma migrate deploy`). Voir schema.prisma.
DIRECT_URL="postgresql://postgres:password@localhost:5432/medassur_dev?schema=public"
# Obligatoire, 32 caractères minimum (ex. : openssl rand -hex 32) — le serveur refuse de démarrer sinon.
JWT_SECRET="change-me-with-at-least-32-random-characters"
# Définir (ex. TRUST_PROXY=1) uniquement derrière un reverse proxy de confiance : active la lecture de X-Forwarded-For pour la limitation des connexions.
# TRUST_PROXY=
PORT=3001

# Agent IA de la Messagerie (2026-08) — voir MessagerieAgentIaService. Sans
# cette clé, les conversations "canal=IA" restent ouvertes sans réponse
# automatique (dégradation silencieuse, pas d'erreur) jusqu'à ce qu'un agent
# humain les prenne en charge.
ANTHROPIC_API_KEY=

# Stockage de fichiers Supabase (2026-09) — voir StorageService
# (backend/src/storage/). Laissés VIDES en local : StorageService reste
# inactif et les services continuent d'utiliser le disque local
# (uploads/), sans aucun changement de comportement. Renseignés seulement
# en production — URL du projet + clé service_role (Project Settings →
# API), jamais la clé anon/publishable (insuffisante en écriture).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# SMS + WhatsApp réels (2026-09) — voir MessagingService (backend/src/
# messaging/), fournisseur Zavu (docs.zavu.dev). Laissés VIDES en local :
# MessagingService reste inactif (envois ignorés, journalisés en debug),
# sans aucun changement de comportement. ZAVU_SENDER_ID facultatif (id de
# l'expéditeur configuré côté Zavu — sender par défaut du compte si omis).
ZAVU_API_KEY=
ZAVU_SENDER_ID=

# Documentation Swagger/OpenAPI, route /api/docs (2026-09) — voir
# swagger.util.ts. Laissés VIDES en local : la route reste accessible SANS
# prompt (pratique en développement). Renseignés en production pour exiger
# une authentification Basic Auth dédiée — jamais les identifiants d'un
# compte applicatif, l'UI expose un bouton "Try it out" capable d'exécuter
# de vraies requêtes.
SWAGGER_USER=
SWAGGER_PASSWORD=

# E-Billing / Digitech (paiements Mobile Money) — secret HMAC qui signe l'URL
# de callback donnée au fournisseur (?sig=). OBLIGATOIRE : sans lui, les
# paiements (payin/payout) sont refusés et les callbacks rejetés (503).
# Générer une valeur aléatoire longue (ex. `openssl rand -hex 32`) ; ne jamais
# la commiter. APP_URL doit être l'URL publique du backend (https).
# EBILLING_MAX_MONTANT (optionnel) : plafond par opération en FCFA (50000000).
EBILLING_CALLBACK_SECRET=

# Webhook entrant Zavu (POST /api/webhooks/zavu) — secret de signature fourni
# par Zavu. OBLIGATOIRE : sans lui le webhook est désactivé (401 systématique).
ZAVU_WEBHOOK_SECRET=

# CORS : liste d'origines navigateur autorisées, séparées par des virgules
# (ex. https://app.exemple.com,https://admin.exemple.com). Vide : en dev,
# localhost:5173/3000 ; en production, aucune origine navigateur (le frontend
# servi par ce même serveur est same-origin ; les apps mobiles n'envoient pas
# d'Origin). APP_URL, s'il est défini, est aussi autorisé.
CORS_ORIGINS=
