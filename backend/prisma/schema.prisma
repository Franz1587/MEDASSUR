// ── GED ──────────────────────────────────────────────────────────────
// Étendue (2026-09) — voir demande utilisateur : "activer la fonctionnalité
// de GED afin qu'on puisse importer les factures et les courriers des
// prestataires... archivage des documents qui rentrent et qui sortent...
// mode OCR grâce à l'agent IA... enregistrement automatique du document
// avec un résumé et en créant l'objet en lisant le contenu... suivi et
// comparaison des factures enregistrées par la GED et celles traitées et
// saisies". Avant cette extension, le modèle n'avait ni fichier réel, ni
// sens (entrant/sortant), ni aucun champ extrait par IA — un simple
// classeur d'étiquettes saisies à la main (voir GedService d'origine).
model GedDocument {
  id              String   @id
  // Isolation multi-tenant (2026-09) — comblé après coup, voir Conversation
  // ci-dessus pour le détail du bug (interrogé sans filtrage).
  societeId String?
  societe   SocieteAssurance? @relation(fields: [societeId], references: [id])
  nom             String
  type            String
  entiteLiee      String
  // "En attente" (import juste reçu, lecture IA pas encore terminée) |
  // "Analysé" (lecture IA terminée avec succès) | "Échec" (illisible —
  // format non supporté par la vision de Claude, ou fichier corrompu).
  statutOcr       String
  statutSignature String
  tags            String[]
  date            String

  // Fichier réel (2026-09) — nom stocké sous uploads/ged/ (disque local) ou
  // Supabase Storage (catégorie "ged") selon StorageService.actif, même
  // principe que les autres pièces jointes de l'application (accords
  // préalables, signatures...). Absent uniquement pour les quelques
  // documents créés avant cette extension (jamais réédités).
  fichier String?

  // Sens du document (2026-09) — "Entrant" (reçu de l'extérieur : facture
  // ou courrier d'un prestataire, par exemple) | "Sortant" (envoyé par
  // l'entreprise). Aucun concept équivalent n'existait avant cette
  // extension — voir demande utilisateur : "permettre l'archivage des
  // documents qui rentrent et qui sortent de l'entreprise, pour un
  // meilleur suivi documentaire."
  sens String @default("Entrant")

  // Lecture automatique par l'agent IA (2026-09) — voir
  // GedAnalyseService.analyser. `objet`/`resume` sont le résultat de la
  // lecture réelle du contenu (jamais une valeur devinée si l'IA n'a pas pu
  // lire le fichier — restent alors null, `nom` sert de repli à l'écran).
  objet  String?
  resume String?

  // Rapprochement facture prestataire (2026-09) — voir demande utilisateur :
  // "comparaison entre les factures enregistrées par la GED et celles
  // traitées et saisies afin de dire lesquelles ont été traitées totalement
  // et lesquelles l'ont été partiellement." `referenceExtraite`/
  // `montantExtrait` viennent de la lecture IA (jamais garantis exacts —
  // l'OCR peut se tromper, d'où le rapprochement manuel possible en plus de
  // l'automatique, voir GedService.rapprocherFacture) ; `factureId` n'est
  // renseigné qu'une fois un rapprochement (auto ou manuel) confirmé.
  prestataireId     String?
  prestataire       Prestataire? @relation(fields: [prestataireId], references: [id])
  referenceExtraite String?
  montantExtrait    Decimal?     @db.Decimal(18, 2)
  factureId         String?
  facture           Facture?     @relation(fields: [factureId], references: [id])
  // "Sans objet" (document qui n'est pas une facture prestataire — un
  // courrier, par exemple) | "Non traité" (facture importée, aucune saisie
  // correspondante trouvée) | "Traité partiellement" (saisie trouvée mais
  // encore "En saisie", ou montant saisi ≠ montant lu) | "Traité totalement"
  // (saisie "Soumise" avec un montant qui correspond).
  statutTraitement String @default("Sans objet")

  demandeurId String?
  demandeur   User?   @relation(fields: [demandeurId], references: [id])
  createdAt   DateTime @default(now())

  @@index([societeId])
  @@index([prestataireId])
  @@index([factureId])
  @@index([statutTraitement])
}

// ── Facture Production (2026-08) ────────────────────────────────────
// Facture de production émise par opération (nouveau contrat, avenant…),
// GÉNÉRÉE MANUELLEMENT à la demande depuis son propre écran (voir demande
// utilisateur — pas de déclenchement automatique à la sauvegarde d'un
// contrat/avenant). Imprimée sur le papier en-tête de la COMPAGNIE (pied de
// page/RIB = champs Compagnie ajoutés ci-dessus), jamais sur celui de
// MedAssur — voir DocumentsService.renderFactureProduction.
model FactureProduction {
  id          String @id @default(cuid())

  // Isolation multi-tenant (2026-09, Phase 2) -- voir SocieteAssurance /
  // User.societeId. Nullable en base (donnees anterieures au cloisonnement,
  // voir migration 20260906130000_societe_scoping, backfill vers
  // 'societe-bootstrap') mais injecte/filtre automatiquement par le
  // middleware Prisma (voir PrismaService, TenantContext) -- jamais lu/ecrit
  // a la main dans les services metier.
  societeId String?
  societe   SocieteAssurance? @relation(fields: [societeId], references: [id])
  // Numéro séquentiel, atomique (CompteurDocument id="facture-production"),
  // affiché "FACTURE N°{numero}/{année d'émission}" comme sur le modèle NSIA.
  numero      Int
  compagnieId String
  clientId    String
  contratId   String?

  dateEmission String
  lieuEmission String @default("Libreville")

  // Références facultatives (Bon de Réception/Commande du client) — visibles
  // sur le modèle NSIA quand renseignées, omises sinon.
  referenceBonReception String?
  referenceBonCommande  String?

  objet         String
  // Type de paiement (2026-08, voir demande utilisateur : "marquer... le
  // type de paiement... plusieurs échéanciers comme un paiement unique en
  // une seule fois... sur le modèle c'est représenté par 'PRIME PREMIERE
  // ECHEANCE'") — "Paiement intégral" | "1ère échéance" | "2ème échéance" |
  // "3ème échéance" | "4ème échéance". Affiché sous le titre de la facture
  // (voir DocumentsService.renderFactureProduction) et repris en suffixe
  // des libellés de ligne auto-remplis dès que ≠ "Paiement intégral".
  typePaiement  String  @default("Paiement intégral")
  notePaiement  String?
  statut        String @default("Émise")
  createdAt     DateTime @default(now())

  compagnie Compagnie              @relation(fields: [compagnieId], references: [id])
  client    Client                 @relation(fields: [clientId], references: [id])
  contrat   Contrat?               @relation(fields: [contratId], references: [id])
  lignes    FactureProductionLigne[]

  @@index([societeId])
}

model FactureProductionLigne {
  id                  String   @id @default(cuid())
  factureProductionId String
  // Ex. "POLICE MALADIE N°1000652 (Non Cadres)" — libellé souligné sur le PDF.
  libelle             String
  periodeDebut        String?
  periodeFin          String?
  montant             Decimal  @db.Decimal(18, 2)
  ordre               Int      @default(0)

  // Mouvement d'origine (2026-08, voir demande utilisateur : sélection par
  // souscripteur → auto-remplissage des mouvements pas encore facturés).
  // contratId seul = ligne "Affaire Nouvelle" (la souscription du contrat
  // elle-même) ; contratId + avenantId = ligne d'un avenant précis. Sert à
  // exclure ces mouvements des suggestions une fois déjà facturés (voir
  // FactureProductionService.mouvementsNonFactures) — jamais renseigné pour
  // une ligne saisie librement.
  contratId String?
  avenantId String?

  factureProduction FactureProduction @relation(fields: [factureProductionId], references: [id], onDelete: Cascade)
  contrat           Contrat?          @relation(fields: [contratId], references: [id])
  avenant           Avenant?          @relation(fields: [avenantId], references: [id])
}

// ── Courrier Maladie (2026-08) ──────────────────────────────────────
// Éditeur façon Word (voir demande utilisateur) pour la correspondance liée
// à la santé (factures, prises en charge…). Modèles paramétrables
// (CourrierType) avec jetons de substitution, référence auto-générée
// incluant les initiales de l'agent connecté (voir CourrierService.create,
// User.initiales déjà existant).
model CourrierType {
  id          String  @id @default(cuid())
  // Isolation multi-tenant (2026-09) — comblé après coup, voir Conversation
  // ci-dessus pour le détail du bug (interrogé sans filtrage). Chaque
  // société a ses propres modèles de courrier (marque/ton propres), jamais
  // un catalogue partagé comme ActeMedical/CodeAffection.
  societeId String?
  societe   SocieteAssurance? @relation(fields: [societeId], references: [id])
  libelle     String
  // Corps HTML modèle — jetons {{DESTINATAIRE}}, {{DATE}}, {{REFERENCE}},
  // {{OBJET}} substitués à la création d'un courrier à partir de ce type
  // (voir CourrierService.create). Sous-ensemble HTML volontairement limité
  // (voir RichTextEditor.tsx / DocumentsService.renderCourrier) : <p>,
  // <b>/<strong>, <i>/<em>, <u>, <ul>/<ol>/<li>, style text-align/font-size.
  corpsModele String
  actif       Boolean @default(true)

  courriers Courrier[]

  @@index([societeId])
}

model Courrier {
  id        String   @id @default(cuid())

  // Isolation multi-tenant (2026-09, Phase 2) -- voir SocieteAssurance /
  // User.societeId. Nullable en base (donnees anterieures au cloisonnement,
  // voir migration 20260906130000_societe_scoping, backfill vers
  // 'societe-bootstrap') mais injecte/filtre automatiquement par le
  // middleware Prisma (voir PrismaService, TenantContext) -- jamais lu/ecrit
  // a la main dans les services metier.
  societeId String?
  societe   SocieteAssurance? @relation(fields: [societeId], references: [id])
  // Format COUR-{année}-{6 car. aléatoires}-{INITIALES} — voir
  // CourrierService.create (initiales = User.initiales de l'agent connecté).
  reference String   @unique
  typeId    String?
  objet     String

  destinataireNom     String
  destinataireAdresse String?

  // Lien facultatif vers un dossier existant — préremplit le destinataire à
  // la création et permet la recherche multi-critères (voir demande
  // utilisateur : "recherche... avec tous les critères").
  clientId      String?
  prestataireId String?
  assureId      String?

  corps       String // HTML produit par l'éditeur (RichTextEditor.tsx)
  auteurId    String
  dateCreation String
  statut      String @default("Généré")

  type        CourrierType? @relation(fields: [typeId], references: [id])
  client      Client?       @relation(fields: [clientId], references: [id])
  prestataire Prestataire?  @relation(fields: [prestataireId], references: [id])
  assure      AssureSante?  @relation(fields: [assureId], references: [id])
  auteur      User          @relation(fields: [auteurId], references: [id])

  @@index([societeId])
}

// ── Règles & Consignes (2026-08) ────────────────────────────────────
// Règles et consignes d'utilisation de l'assurance maladie, mises en place
// côté assurance (zone "Système") et diffusées en LECTURE SEULE au portail
// client — voir demande utilisateur : "on fera remonter toutes les règles
// et consigne pour utiliser l'assurance maladie... c'est eux qui vont
// mettre en place cela; le client n'aura cela qu'en lecture seul et pourra
// télécharger les documents joints par l'assurance". Global (pas de
// rattachement Client/Contrat) — s'applique à tous les souscripteurs.
model RegleConsigne {
  id        String   @id @default(cuid())
  titre     String
  contenu   String   @db.Text
  // Document joint facultatif (PDF/Word/etc.) — nom de fichier sous
  // uploads/regles-consignes/, même principe qu'AccordPrealable.ordonnanceFichier.
  fichier   String?
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Signature électronique — capture par QR code (2026-09) ─────────
// Jeton court, à usage unique, qui permet à un téléphone/tablette (qui
// scanne le QR affiché sur l'écran de bureau de l'utilisateur, voir
// UsersController) d'ouvrir une page de signature PUBLIQUE (sans être
// connecté sur cet appareil) puis d'enregistrer le tracé dans le BON
// compte, celui qui a généré le jeton — voir demande utilisateur :
// "l'application devra générer un QR code qui sera scanné... on signe et
// on valide, la signature se charge dans le compte de l'utilisateur."
model SignatureToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ── Base de connaissance de l'agent IA Ariana (2026-09) ─────────────
// Voir demande utilisateur : "afin de faire évoluer l'agent IA Ariana...
// et affiner son niveau d'analyse, je lui donne ses documents pour se
// former" (Code CIMA 2019 + Manuel Assurance Santé CIMA Gabon), et
// séparément : "qu'elle apprenne de la gestion qui se fera dans
// l'application... que cela affine sa capacité à interagir". Ariana tourne
// sur l'API Claude — aucun réentraînement de modèle n'est possible depuis
// cette application ; ceci est donc une mémoire consultée par un OUTIL
// (voir MessagerieAgentIaService.consulter_base_connaissance), jamais
// injectée en bloc dans le prompt (les 608 pages du Code CIMA ne
// tiendraient de toute façon pas dans un contexte raisonnable) — une vraie
// recherche par mots-clés qui ramène seulement les passages pertinents à
// LA question posée. Deux origines dans la même table (même mécanisme de
// recherche) :
// - "Reglementation" : chunks des documents de référence fournis (voir
//   scratch-seed-ariana-connaissance.js, exécuté une fois à l'ingestion).
// - "CasResolu" : résumé automatique généré à la clôture d'une conversation
//   (voir MessagerieService.changerStatut → statut "Resolue"), c'est la
//   partie "apprend de la gestion réelle" — jamais les données personnelles
//   de l'assuré telles quelles, un résumé du TYPE de situation et de sa
//   résolution.
model ArianaConnaissance {
  id        String   @id @default(cuid())
  categorie String // "Reglementation" | "CasResolu"
  source    String // ex. "Code CIMA 2019", "Manuel Assurance Santé CIMA Gabon", "Conversation résolue"
  titre     String
  contenu   String
  // Isolation multi-tenant (2026-09) — un cas résolu de LA RUCHE EXCELLENCE
  // n'a pas à nourrir les réponses données à une autre société ; les
  // documents réglementaires (Reglementation), eux, restent valables pour
  // tous (CIMA s'applique à toute la zone) — societeId NULL = valable pour
  // tous, jamais filtré par le middleware Prisma standard (voir
  // recherche dédiée dans consulter_base_connaissance, pas un findMany
  // générique).
  societeId String?
  createdAt DateTime @default(now())

  @@index([categorie])
  @@index([societeId])
}

// ── Idempotence (mode hors-ligne, 2026-09) ──────────────────────────────
// Fondation transversale pour la synchronisation hors-ligne (web + mobile) :
// voir demande utilisateur "l'application puisse... travailler en off-line...
// une fois la connexion rétablie, les données saisie en off-ligne pourront
// migrer vers le serveur", avec l'exigence explicite d'un "système intégré
// de veille de saisie de doublons... gérer les doublons, les supprimer et
// faire une unicité des données". Plutôt qu'une détection de doublons a
// posteriori (fragile : deux saisies légitimes peuvent se ressembler), la
// prévention se fait à la source : chaque écriture émise par un client
// (web/mobile) porte une clé unique générée UNE SEULE FOIS à la création de
// l'action (avant tout envoi), conservée telle quelle à travers les
// tentatives/rejeux (perte réseau, relance après reconnexion). Voir
// IdempotenceInterceptor (src/idempotence) : si la même clé revient (ex. la
// requête a en fait réussi côté serveur mais la réponse s'est perdue avant
// d'arriver au client hors-ligne, qui rejoue l'action au retour du réseau),
// la réponse déjà produite est renvoyée telle quelle SANS ré-exécuter la
// logique métier — aucune double création possible.
model RequeteIdempotente {
  id        String   @id @default(cuid())
  cle       String   @unique
  reponse   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}
